# このファイルをコピーして .env.local を作成し、実際の値を入れてください。
# .env.local はgit管理対象外です(.gitignoreで除外済み)。

# Google AdSenseの審査に通ってから発行される「パブリッシャーID」。
# "pub-1234567890123456" のような値(先頭の"ca-"は付けない)。
# 空のままなら広告タグ・ads.txt・所有権確認メタタグは一切出力されない。
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Google Search Consoleの「HTMLタグ」確認方式で表示される
# <meta name="google-site-verification" content="..."> のcontent部分の値のみ。
NEXT_PUBLIC_GSC_VERIFICATION=

# 本番URL(Vercelデプロイ後のURLに差し替える)。
NEXT_PUBLIC_SITE_URL=

# ペットフード・ペット保険などのアフィリエイトリンク(ASP提携後に発行されるURLを設定)。
# 空のままなら関連セクション自体を表示しない。
NEXT_PUBLIC_AFFILIATE_CAT_FOOD_URL=
NEXT_PUBLIC_AFFILIATE_DOG_FOOD_URL=
NEXT_PUBLIC_AFFILIATE_PET_INSURANCE_URL=
