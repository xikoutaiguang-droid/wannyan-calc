# このファイルをコピーして .env.local を作成し、実際の値を入れてください。
# .env.local はgit管理対象外です(.gitignoreで除外済み)。

# Google AdSenseの審査に通ってから発行される「パブリッシャーID」。
# "pub-1234567890123456" のような値(先頭の"ca-"は付けない)。
# 空のままなら広告タグ・ads.txt・所有権確認メタタグは一切出力されない。
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Google Search Consoleの「HTMLタグ」確認方式で表示される
# <meta name="google-site-verification" content="..."> のcontent部分の値のみ。
NEXT_PUBLIC_GSC_VERIFICATION=

# 本番URL(Vercelデプロイ後のURLに差し替える)。
NEXT_PUBLIC_SITE_URL=

# Google Cloud Consoleで「Places API (New)」を有効化して発行したAPIキー(サーバー専用、NEXT_PUBLIC_は付けない)。
# 金相場サイトとは別に、このサイト専用のキーを新規発行することを推奨(課金・利用上限を分けるため)。
# 空のままだと「近くの動物病院を探す」機能はエラーメッセージを返すだけになる。
GOOGLE_PLACES_API_KEY=

# ペットフード・ペット保険などのアフィリエイトリンク(ASP提携後に発行されるURLを設定)。
# 空のままなら関連セクション自体を表示しない。
# 猫の年齢計算ページに常時表示(プレミアムキャットフード『ジャガー』)
NEXT_PUBLIC_AFFILIATE_CAT_FOOD_URL=
NEXT_PUBLIC_AFFILIATE_CAT_FOOD_PIXEL=
# 犬の年齢計算ページに常時表示(カナガンドッグフード ハイランドフィースト)
NEXT_PUBLIC_AFFILIATE_DOG_FOOD_URL=
NEXT_PUBLIC_AFFILIATE_DOG_FOOD_PIXEL=
NEXT_PUBLIC_AFFILIATE_PET_INSURANCE_URL=

# A8.net「猫用サプリ」シリーズ(部位別)の広告リンク・計測用ピクセル。
# 猫の年齢計算機でシニア期/高齢期と判定されたときに「気になる部位から選ぶ」リストとして表示される。
NEXT_PUBLIC_AFFILIATE_SENIOR_CAT_SUPPLEMENT_URL=
NEXT_PUBLIC_AFFILIATE_SENIOR_CAT_SUPPLEMENT_PIXEL=
NEXT_PUBLIC_AFFILIATE_LIVER_SUPPLEMENT_URL=
NEXT_PUBLIC_AFFILIATE_LIVER_SUPPLEMENT_PIXEL=
NEXT_PUBLIC_AFFILIATE_JOINT_SUPPLEMENT_URL=
NEXT_PUBLIC_AFFILIATE_JOINT_SUPPLEMENT_PIXEL=
NEXT_PUBLIC_AFFILIATE_EYE_SUPPLEMENT_URL=
NEXT_PUBLIC_AFFILIATE_EYE_SUPPLEMENT_PIXEL=
NEXT_PUBLIC_AFFILIATE_HEART_SUPPLEMENT_URL=
NEXT_PUBLIC_AFFILIATE_HEART_SUPPLEMENT_PIXEL=

# 体重管理ツール専用(毎日習慣: 体重・血糖値)
NEXT_PUBLIC_AFFILIATE_WEIGHT_SUPPLEMENT_URL=
NEXT_PUBLIC_AFFILIATE_WEIGHT_SUPPLEMENT_PIXEL=

# ごはんの量計算ツール専用(毎日爽快: 腸内環境)
NEXT_PUBLIC_AFFILIATE_GUT_SUPPLEMENT_URL=
NEXT_PUBLIC_AFFILIATE_GUT_SUPPLEMENT_PIXEL=

# 猫の年齢計算ページに常時表示(Catlog: 見守りデバイス)
NEXT_PUBLIC_AFFILIATE_CATLOG_URL=
NEXT_PUBLIC_AFFILIATE_CATLOG_PIXEL=
